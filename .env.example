# Gyro Web/API Environment Variables

# 웹(apps/web)이 빌드 시 사용하는 API 기본 주소(개발용 fallback). 배포 시에는
# 컨테이너 엔트리포인트가 런타임에 public/config.json을 생성해 이 값을 대체한다.
VITE_API_URL=http://localhost:3001

# API(apps/api)가 웹에 허용할 CORS Origin.
# Vite 개발 서버 기본 주소. Docker Compose는 3002를 별도로 설정한다.
WEB_ORIGIN=http://localhost:4173

# 빌더 포털은 별도 PostgreSQL과 Azure Communication Services Email 설정이 필요하다.
# 실제 secret은 로컬 secret store/Container App secret에만 두고 저장소에 커밋하지 않는다.
DATABASE_URL=
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=
AZURE_COMMUNICATION_EMAIL_SENDER=
BUILDER_ADMIN_TOKEN=

# API(apps/api)가 리슨할 포트.
PORT=3001

# 로컬 AI: NODE_ENV=development와 함께 명시적으로 활성화한다.
# 공개 서버에서는 copilot을 사용하고 COPILOT_GITHUB_TOKEN을 secret reference로 주입한다.
GYRO_ASSISTANT_PROVIDER=copilot-local
COPILOT_MODEL=
# COPILOT_GITHUB_TOKEN은 이 파일이나 웹 환경 변수에 기록하지 않는다.
