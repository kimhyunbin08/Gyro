# Gyro Web/API Environment Variables

# 웹(apps/web)이 빌드 시 사용하는 API 기본 주소(개발용 fallback). 배포 시에는
# 컨테이너 엔트리포인트가 런타임에 public/config.json을 생성해 이 값을 대체한다.
VITE_API_URL=http://localhost:3001

# API(apps/api)가 웹에 허용할 CORS Origin (Docker Compose 기본값).
# Vite 개발 서버를 쓰면 WEB_ORIGIN=http://localhost:4173 으로 바꾼다.
WEB_ORIGIN=http://localhost:3002

# API(apps/api)가 리슨할 포트.
PORT=3001

# 창업가 플랫폼: 가입은 PostgreSQL, 운영자/정책 정보, 법률 검토 승인,
# 명시적 운영 활성화가 모두 설정되어야 활성화된다. 비밀값을 커밋하지 않는다.
BUILDER_PLATFORM_ENABLED=false
LEGAL_REVIEW_APPROVED=false
DATABASE_URL=
DATABASE_SSL=verify
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BUILDER_MODERATOR_EMAILS=
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
PRIVACY_POLICY_VERSION=
TERMS_VERSION=
AI_PROCESSOR_NOTICE=
DATA_RETENTION_POLICY=

# 로컬 AI: NODE_ENV=development와 함께 명시적으로 활성화한다.
# 공개 서버에서는 copilot을 사용하고 COPILOT_GITHUB_TOKEN을 secret reference로 주입한다.
GYRO_ASSISTANT_PROVIDER=copilot-local
COPILOT_MODEL=
# COPILOT_GITHUB_TOKEN은 이 파일이나 웹 환경 변수에 기록하지 않는다.
